# CrewCash V2 — Environment Configuration Template
# Copy this file to `.env.local` or `.env` and fill in your keys.

# =========================================================
# 1. CORE APPLICATION & DEMO MODE
# =========================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to true for live hackathon judging & testing without requiring external credentials:
NEXT_PUBLIC_DEMO_MODE=true

# =========================================================
# 2. GOOGLE GEMINI API (Primary AI Sponsor)
# =========================================================
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Recommended model: gemini-1.5-flash or gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash

# Backward-compatibility fallback:
# AI_PROVIDER=gemini
# AI_API_KEY=your_gemini_api_key_here

# =========================================================
# 3. TIGER DATA / POSTGRESQL (Primary Database Sponsor)
# =========================================================
# Connection string from Tiger Cloud or local PostgreSQL:
# e.g., postgresql://username:password@your-tiger-host:5432/crewcash?sslmode=require
DATABASE_URL=

# =========================================================
# 4. AUTHENTICATION & STORAGE (Choose Provider)
# =========================================================
# If using Supabase for Auth / Storage:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# If using Clerk:
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Private Object Storage (S3 / R2 / Supabase Storage for receipts):
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# =========================================================
# 5. OPTIONAL SPONSORS & INTEGRATIONS
# =========================================================
# Optional: Market Data (Polygon, AlphaVantage, or Finnhub)
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=

# Optional: Solana Devnet Anchor for High-Value Approvals
# MLH Rowdy Hacks — Best Use of Solana (tamper-evident approval digests)
# RPC: https://api.devnet.solana.com
# PRIVATE_KEY: Solana CLI keypair JSON byte array, e.g. contents of keys/solana-devnet-keypair.json
#   solana-keygen new --outfile keys/solana-devnet-keypair.json
#   Then paste the JSON array as SOLANA_PRIVATE_KEY, or export:
#   SOLANA_PRIVATE_KEY=$(cat keys/solana-devnet-keypair.json)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PRIVATE_KEY=

# Optional: ElevenLabs AI Voice Briefings
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
